# Sao chép thành .env và thay TẤT CẢ giá trị "change-me".
# Tạo nhanh secret ngẫu nhiên:  bash deploy/scripts/gen-env.sh
# KHÔNG commit file .env. Prod: secret lấy từ OpenBao, không để trong file.

AIAGENT_ENV=dev
AIAGENT_LOG_LEVEL=INFO

POSTGRES_PASSWORD=change-me
AIAGENT_APP_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
REDIS_PASSWORD=change-me

KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=change-me
PUBLIC_KEYCLOAK_URL=http://localhost:8080

# (Phase 3b: OpenBao server mode + AppRole — không còn root token tĩnh)

# Role chỉ-đọc của database demo (docker compose --profile demo run --rm demo-seed).
DEMO_READER_PASSWORD=change-me

# Khóa bí mật của SearXNG (máy tìm kiếm tự host cho skill web).
SEARXNG_SECRET=change-me

# OAuth cho connector (Phase 3b). Keycloak: client "aries-connector" tạo bằng
#   docker compose --profile demo run --rm keycloak-setup
OAUTH_KEYCLOAK_CLIENT_SECRET=change-me
# Google: tạo OAuth client (Web) với redirect http://<host>/api/v1/oauth/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# API key của MCP server mẫu (docker compose --profile demo up -d mcp-demo)
MCP_DEMO_API_KEY=change-me

# Claude API key (tùy chọn). Để trống: chỉ chạy được agent dùng model giả "fake-echo".
# Không commit key; Phase 3 chuyển sang OpenBao.
ANTHROPIC_API_KEY=
AIAGENT_LLM_FAKE_ENABLED=true

# ---- Model AI miễn phí / tự host (tùy chọn, bật bao nhiêu cũng được) — docs/llm-providers.md
# Gemini (Google AI Studio, có free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (free tier, rất nhanh): https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (các model có hậu tố ":free"): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Danh sách model cố định (JSON). [] = tự lấy từ API của provider.
GEMINI_MODELS=[]
GROQ_MODELS=[]
OPENROUTER_MODELS=[]

# Ollama local: docker compose --profile ollama up -d ollama ollama-pull
OLLAMA_BASE_URL=
# Model sẽ pull (cách nhau bởi dấu cách), ví dụ: qwen3:8b llama3.2:3b gemma3:4b
OLLAMA_MODELS=qwen3:8b
OLLAMA_MODELS_ALLOWED=[]

# Provider + model cho Agent Architect (dựng agent bằng ngôn ngữ tự nhiên).
# Ví dụ dùng Gemini: ARCHITECT_PROVIDER=gemini, ARCHITECT_MODEL=<model gemini>…
ARCHITECT_PROVIDER=anthropic
ARCHITECT_MODEL=claude-opus-5-5
ARCHITECT_FAST_MODEL=claude-haiku-5-5
ARCHITECT_JUDGE_MODEL=claude-sonnet-5-5
